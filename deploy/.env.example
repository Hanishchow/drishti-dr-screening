# Copy to deploy/.env and fill in. Compose refuses to start without the
# required values, which is intentional.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DRISHTI_SECRET_KEY=
POSTGRES_PASSWORD=

DRISHTI_NODE_ID=district-sivaganga
DRISHTI_PORT=8000
DRISHTI_DEVICE=auto
DRISHTI_BATCH_SIZE=8

# Creates the first admin on an empty database, then never again.
DRISHTI_BOOTSTRAP_ADMIN_EMAIL=admin@district.gov.in
DRISHTI_BOOTSTRAP_ADMIN_PASSWORD=

# Comma-separated. Do not use a wildcard.
DRISHTI_CORS_ORIGINS=http://localhost:8000
